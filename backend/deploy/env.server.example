# 服务器端 .env 模板（复制成 backend/.env 后按实际改）
# 密钥不进仓库：本文件只有占位符
PORT=8099
PUBLIC_BASE_URL=http://127.0.0.1:8099

# 后端和 MySQL 在同一台服务器时用 127.0.0.1；跨机填内网/公网 IP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填数据库口令
DB_NAME=jieshenxiche
DB_CONN_LIMIT=10

# 后台与小程序的员工口令，上线务必改成自己的
# 手机号加密密钥（32 字节 base64，生成：npm run keygen -- --write）
PHONE_ENC_KEY=

ADMIN_TOKEN=请改成你的员工口令

# 车牌识别：不填密钥自动走模拟识别（MOCK_OCR=1）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
MOCK_OCR=1
