# ---------- 服务 ----------
PORT=8099
# 小程序端请求前缀（部署到 https 域名后改成你的域名）
PUBLIC_BASE_URL=http://127.0.0.1:8099

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填入数据库口令
DB_NAME=jieshenxiche
DB_CONN_LIMIT=10

# ---------- 管理员口令（小程序「门店管理」页输入） ----------
ADMIN_TOKEN=请改成你自己的员工口令

# ---------- 车主端微信登录（不填则自动 mock） ----------
WX_APPID=
WX_SECRET=
WX_MOCK=0
# 员工/老板手机号白名单（逗号分隔）：命中即进门店端，其余按车主处理
STAFF_PHONES=

# ---------- 车牌识别（腾讯云 OCR · LicensePlateOCR） ----------
# 不填 SECRET 时自动走 MOCK_OCR（本地开发/演示直接可用）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
# 1 = 强制走模拟识别（不花钱、断网可用）
MOCK_OCR=0
