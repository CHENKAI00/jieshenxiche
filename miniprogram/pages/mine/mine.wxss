.profile { display: flex; align-items: center; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 48rpx;
  background: linear-gradient(135deg, #0b7bd8, #17c3b2);
  color: #fff; font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.field { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.field-k { width: 130rpx; color: #7b8a9a; font-size: 26rpx; }
.eye { color: #0b7bd8; font-size: 24rpx; }
.arrow { color: #c3ccd6; font-size: 34rpx; }
.foot { text-align: center; color: #b3bfcc; font-size: 20rpx; padding-top: 12rpx; }
