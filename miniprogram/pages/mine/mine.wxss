.page-head { padding: 10rpx 8rpx 24rpx; }

.profile {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(15, 28, 42, 0.05);
}
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, #0b7bd8, #17c3b2);
  color: #fff; font-size: 42rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.name { font-size: 36rpx; font-weight: 700; color: var(--ink); }
.sub-line { font-size: 22rpx; color: var(--sub); margin-top: 8rpx; }

.van-cell-group--inset { margin: 0 0 24rpx; }
.van-cell { padding: 28rpx 30rpx; font-size: 28rpx; }

.dev { margin-top: 4rpx; }
.field { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.field-k { width: 130rpx; color: var(--sub); font-size: 24rpx; flex: none; }
.eye { color: var(--brand); font-size: 24rpx; }

.status { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #c9d2da; }
.dot.on { background: #17c3b2; box-shadow: 0 0 0 6rpx rgba(23, 195, 178, 0.14); }

.mono-line {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 22rpx;
  color: #35485a;
  margin-top: 8rpx;
  word-break: break-all;
}
.ver { text-align: center; color: #b6c0cb; font-size: 20rpx; padding: 16rpx 0 20rpx; }
