<view class="page">
  <view class="page-head">
    <view class="t">门店端</view>
    <view class="s">洁神洗车 · 员工工作台</view>
  </view>

  <view class="profile">
    <view class="avatar">{{staffInitial}}</view>
    <view class="col grow" style="margin-left:24rpx">
      <text class="name">{{staffName}}</text>
      <text class="sub-line">当前身份：门店员工</text>
    </view>
    <text class="tag mint">在线</text>
  </view>

  <van-cell-group inset>
    <van-cell title="会员名录" icon="friends-o" is-link bind:click="openMembers" />
    <van-cell title="店内项目与价目" icon="shop-o" is-link bind:click="showPrice" />
    <van-cell title="切换到车主端" icon="exchange" is-link bind:click="goCustomer" />
    <van-cell title="关于洁神洗车" icon="info-o" is-link bind:click="showAbout" />
  </van-cell-group>

  <van-cell-group inset>
    <van-cell title="开发者设置" icon="setting-o" is-link
              value="{{showDev ? '收起' : '服务地址 / 口令'}}" bind:click="toggleDev" />
  </van-cell-group>

  <view class="dev card" wx:if="{{showDev}}">
    <view class="field">
      <text class="field-k">服务地址</text>
      <input class="input grow" value="{{baseUrl}}" bindinput="onBase" placeholder="http://127.0.0.1:8099" />
    </view>
    <view class="field">
      <text class="field-k">员工口令</text>
      <input class="input grow" password="{{!showToken}}" value="{{token}}" bindinput="onToken" placeholder="ADMIN_TOKEN" />
      <text class="eye" bindtap="toggleToken">{{showToken ? '隐藏' : '显示'}}</text>
    </view>
    <view class="field">
      <text class="field-k">员工姓名</text>
      <input class="input grow" value="{{staffName}}" bindinput="onStaff" placeholder="写进核销记录的操作人" />
    </view>
    <button class="btn" bindtap="save">保存并测试连接</button>

    <view class="status">
      <text class="dot {{health.db === 'up' ? 'on' : ''}}"></text>
      <text class="small">数据库 {{health.db}} · OCR {{health.ocr}}</text>
    </view>

    <view class="divider"></view>
    <view class="between" bindtap="copyOpenid">
      <view class="col" style="flex:1;min-width:0">
        <text class="small">本机微信 openid（老板免密用）</text>
        <text class="mono-line">{{openid || '点一下获取并复制'}}</text>
      </view>
      <text class="small" style="color:#0b7bd8">复制</text>
    </view>
  </view>

  <view class="ver">洁神洗车 · 门店端 v1.0</view>
</view>
