<view class="page">
  <view wx:if="{{!loaded}}" class="loading">正在读取会员档案…</view>

  <!-- 会员卡 -->
  <view wx:if="{{loaded}}" class="mcard">
    <view class="mcard-top between">
      <view class="col">
        <view class="plate" style="color:#fff">{{member.platePretty || platePretty}}</view>
        <view class="mcard-sub">{{member.exists === false ? '未建档车牌' : member.nickname}}</view>
      </view>
      <view class="tag mint">{{member.exists === false ? '待建档' : member.memberNo}}</view>
    </view>

    <view class="mcard-balance">
      <view class="col">
        <text class="mcard-label">储值余额</text>
        <text class="mcard-money">¥{{balanceText}}</text>
      </view>
      <view class="col" style="align-items:flex-end">
        <text class="mcard-label">剩余次数</text>
        <text class="mcard-money">{{member.remainCount || 0}}<text class="unit">次</text></text>
      </view>
    </view>

    <view class="mcard-counts">
      <view class="mc"><text class="mc-n">{{member.washCount || 0}}</text><text class="mc-l">洗车</text></view>
      <view class="mc"><text class="mc-n">{{member.waxCount || 0}}</text><text class="mc-l">打蜡</text></view>
      <view class="mc"><text class="mc-l" style="margin-top:10rpx">{{member.lastItem ? '最近 ' + member.lastItem : '暂无服务记录'}}</text></view>
    </view>
  </view>

  <!-- 已建档：快捷操作 -->
  <block wx:if="{{member.exists}}">
    <view class="actions">
      <view class="action" bindtap="openConsume">
        <view class="action-ico">🧽</view>
        <view class="action-txt">服务核销</view>
      </view>
      <view class="action" bindtap="goRecharge">
        <view class="action-ico">💳</view>
        <view class="action-txt">充值开卡</view>
      </view>
      <view class="action" bindtap="callOwner">
        <view class="action-ico">📞</view>
        <view class="action-txt">联系车主</view>
      </view>
      <view class="action" bindtap="goMembers">
        <view class="action-ico">👥</view>
        <view class="action-txt">会员名录</view>
      </view>
    </view>

    <view class="card">
      <view class="between">
        <view class="h2">会员资料</view>
        <text class="small" style="color:#0b7bd8" bindtap="editPhone">{{member.phone ? '改手机号' : '补登手机号'}}</text>
      </view>
      <view class="info-row"><text class="info-k">卡号</text><text class="info-v">{{member.memberNo}}</text></view>
      <view class="info-row"><text class="info-k">车型</text><text class="info-v">{{member.carModel || '未填写'}}</text></view>
      <view class="info-row"><text class="info-k">手机</text><text class="info-v">{{member.phone || '未登记'}}</text></view>
      <view class="info-row"><text class="info-k">剩余次数</text><text class="info-v">{{member.remainCount}} 次{{member.expireAt ? '（有效期至 ' + member.expireAt + '）' : ''}}</text></view>
      <view class="info-row"><text class="info-k">洗车 / 打蜡</text><text class="info-v">{{member.washCount}} 次 / {{member.waxCount}} 次</text></view>
      <view class="info-row"><text class="info-k">最近一次</text><text class="info-v">{{member.lastItem || '—'}}<text wx:if="{{member.lastServiceAt}}"> · {{lastAgo}}</text></text></view>
      <view class="info-row" wx:if="{{member.remark}}"><text class="info-k">备注</text><text class="info-v">{{member.remark}}</text></view>
    </view>

    <view class="card">
      <view class="between">
        <view class="h2">店内项目</view>
        <text class="small" bindtap="goCatalog">全部 ›</text>
      </view>
      <view class="svc-grid">
        <view wx:for="{{services}}" wx:key="id" class="svc" data-id="{{item.id}}" bindtap="pickService">
          <image wx:if="{{item.imageUrl}}" class="svc-img" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="svc-img ph">{{item.emoji}}</view>
          <view class="svc-name">{{item.name}}</view>
          <view class="svc-price">¥{{item.price}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 未建档：建档表单 -->
  <block wx:else>
    <view class="card">
      <view class="h2">新建会员档案</view>
      <view class="small" style="margin:12rpx 0 28rpx">一次建档，之后拍照即可识别</view>
      <view class="field">
        <text class="field-k">车牌</text>
        <input class="input grow" value="{{form.plateNo}}" bindinput="onForm" data-k="plateNo" maxlength="8" />
      </view>
      <view class="field">
        <text class="field-k">称呼</text>
        <input class="input grow" value="{{form.nickname}}" placeholder="如 张先生" bindinput="onForm" data-k="nickname" />
      </view>
      <view class="field">
        <text class="field-k">车型</text>
        <picker class="grow" range="{{carModelOptions}}" value="{{carModelIndex}}" bindchange="onCarModel">
          <view class="input">{{carModelOptions[carModelIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="field-k">手机</text>
        <input class="input grow" type="number" value="{{form.phone}}" placeholder="用于联系车主" bindinput="onForm" data-k="phone" maxlength="11" />
      </view>
      <view class="field">
        <text class="field-k">备注</text>
        <input class="input grow" value="{{form.remark}}" placeholder="如 只洗外观 / 有充电口注意" bindinput="onForm" data-k="remark" />
      </view>
      <button class="btn warn" style="margin-top:12rpx" bindtap="submitCreate">建档并开通</button>
    </view>
  </block>

  <view class="foot">洁神洗车 · 会员卡</view>
</view>
