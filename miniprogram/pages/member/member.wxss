.loading { text-align: center; color: #7b8a9a; font-size: 26rpx; padding: 60rpx 0; }
.mcard {
  background: linear-gradient(140deg, #0b2b4a, #0b5f96 70%, #0b7bd8);
  border-radius: 30rpx;
  padding: 32rpx 30rpx 26rpx;
  color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(11, 43, 74, 0.28);
  margin-bottom: 24rpx;
}
.mcard-sub { font-size: 24rpx; color: rgba(255,255,255,0.72); margin-top: 10rpx; }
.mcard-balance { display: flex; justify-content: space-between; margin-top: 40rpx; }
.mcard-label { font-size: 22rpx; color: rgba(255,255,255,0.65); }
.mcard-money { font-size: 52rpx; font-weight: 700; margin-top: 6rpx; letter-spacing: 1rpx; }
.unit { font-size: 24rpx; margin-left: 6rpx; opacity: 0.8; }
.mcard-foot {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.16);
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.actions { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.action {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(11,43,74,0.05);
}
.action-ico { font-size: 40rpx; }
.action-txt { font-size: 22rpx; color: #35485a; margin-top: 8rpx; }

.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f4f7fa; }
.info-row:last-child { border-bottom: none; }
.info-k { color: #7b8a9a; font-size: 26rpx; }
.info-v { font-size: 26rpx; color: #16232f; max-width: 460rpx; text-align: right; }

.flow { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f4f7fa; }
.flow:last-child { border-bottom: none; }
.flow-title { font-size: 28rpx; font-weight: 600; }
.flow-amt { font-size: 28rpx; font-weight: 700; color: #e8543a; }
.flow-amt.in { color: #0f9b8e; }

.field { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.field-k { width: 96rpx; color: #7b8a9a; font-size: 26rpx; }

.foot { text-align: center; color: #b3bfcc; font-size: 20rpx; padding: 12rpx 0 20rpx; }

.svc-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.svc {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  background: #f7fafd;
  border-radius: 18rpx;
  padding: 0 0 16rpx;
  overflow: hidden;
  text-align: center;
}
.svc-img { width: 100%; height: 130rpx; display: block; }
.svc-img.ph {
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; background: linear-gradient(135deg, #e8f4ff, #dffaf6);
}
.svc-name { font-size: 24rpx; font-weight: 600; color: #16232f; margin-top: 12rpx; }
.svc-price { font-size: 24rpx; color: #0b7bd8; font-weight: 700; margin-top: 4rpx; }

.mcard-counts {
  display: flex;
  align-items: center;
  gap: 34rpx;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.16);
}
.mc { display: flex; flex-direction: column; align-items: center; }
.mc-n { font-size: 34rpx; font-weight: 700; }
.mc-l { font-size: 20rpx; color: rgba(255,255,255,0.7); margin-top: 4rpx; }
