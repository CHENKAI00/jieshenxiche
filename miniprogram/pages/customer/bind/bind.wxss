page { background: #f5f7fa; }

.bind-head { padding: 16rpx 8rpx 28rpx; }
.bind-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.bind-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.7;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.card-title { font-size: 30rpx; font-weight: 700; color: #1f2937; }
.small { font-size: 24rpx; color: #6b7280; }

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}
.gap { height: 24rpx; }
.gap-lg { height: 36rpx; }

/* 车牌后缀的相机按钮：88×88，与输入框同高 */
.cam {
  width: 88rpx;
  height: 88rpx;
  margin-right: -24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 16rpx 0;
  background: #eaf2ff;
}
.cam__icon { font-size: 36rpx; line-height: 1; }
.cam__spin {
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 3rpx solid rgba(43, 127, 255, 0.25);
  border-top-color: #2b7fff;
  animation: cam-spin 0.8s linear infinite;
}
@keyframes cam-spin { to { transform: rotate(360deg); } }
