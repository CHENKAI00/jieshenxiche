<view class="page">
  <view class="bind-head">
    <view class="bind-title">绑定我的爱车</view>
    <view class="bind-sub">车牌要和门店登记的一致；手机号填完整 11 位或后 4 位都能绑（不需要短信验证码）</view>
  </view>

  <view class="card">
    <wash-field
      label="车牌号"
      plate
      value="{{plateNo}}"
      maxlength="8"
      placeholder="粤B12345"
      error="{{plateError}}"
      clearable
      bindinput="onPlate"
      bindclear="onPlateClear"
    >
      <view slot="suffix" class="cam {{ocrLoading ? 'is-loading' : ''}}" catchtap="pickImage">
        <view wx:if="{{ocrLoading}}" class="cam__spin"></view>
        <text wx:else class="cam__icon">📷</text>
      </view>
    </wash-field>
    <view class="hint">点右侧相机可拍照或从相册选一张，自动识别车牌</view>

    <view class="gap"></view>

    <wash-field
      label="手机号"
      type="number"
      maxlength="11"
      value="{{phone}}"
      placeholder="登记手机号，或后 4 位"
      bindinput="onPhone"
    />

    <view class="gap-lg"></view>
    <wash-button type="primary" block loading="{{submitting}}" bindtap="submit">确认绑定</wash-button>
  </view>

  <view class="card">
    <view class="card-title">还没办卡？</view>
    <view class="small" style="margin-top:12rpx;line-height:1.7">
      到店把车牌告诉前台，建档后就能绑定；洗车、打蜡都能计次或扣余额。
    </view>
  </view>
</view>
