<view class="page">
  <view class="hero">
    <view class="check">
      <view class="circle"></view>
      <view class="tick"></view>
    </view>
    <view class="title">{{title}}</view>
    <view class="desc">{{desc}}</view>
  </view>

  <view class="card info" wx:if="{{booking}}">
    <view class="row"><text class="k">预约编号</text><text class="v mono">{{booking.id}}</text></view>
    <view class="row"><text class="k">项目</text><text class="v">{{booking.serviceName}}</text></view>
    <view class="row"><text class="k">到店时间</text><text class="v">{{booking.date}} {{booking.time}}</text></view>
    <view class="row"><text class="k">车牌</text><text class="v">{{booking.plateNo}}</text></view>
    <view class="row"><text class="k">状态</text><text class="v" style="color:#0b7bd8">{{booking.statusText}}</text></view>
    <view class="row" wx:if="{{booking.remark}}"><text class="k">备注</text><text class="v">{{booking.remark}}</text></view>
  </view>

  <view class="actions">
    <button class="btn" bindtap="goOrders">查看我的预约</button>
    <button class="btn ghost" style="margin-top:24rpx" bindtap="goHome">返回我的卡</button>
  </view>

  <view class="tip">请按时到店，迟到 15 分钟以上可能需要重新排队</view>
</view>
