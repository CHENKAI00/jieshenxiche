.cpage { padding-bottom: 20rpx; }
.tabbar-gap { height: 130rpx; }

.banner {
  border-radius: 26rpx;
  padding: 32rpx 30rpx;
  background: linear-gradient(140deg, #0b2b4a, #0b5f96 60%, #0b7bd8);
  color: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 14rpx 34rpx rgba(11, 43, 74, 0.2);
}
.banner-t { font-size: 38rpx; font-weight: 700; }
.banner-s { font-size: 23rpx; color: rgba(255, 255, 255, 0.75); margin-top: 8rpx; }

.tabs { white-space: nowrap; margin-bottom: 20rpx; }
.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #5b6b7b;
  font-size: 26rpx;
}
.tab.on { background: linear-gradient(135deg, #0b7bd8, #17c3b2); color: #fff; font-weight: 600; }

.svc-card {
  display: flex;
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 26rpx rgba(11, 43, 74, 0.06);
}
.svc-img { width: 220rpx; height: 176rpx; flex: none; }
.svc-img.ph {
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx;
}
.svc-img.ph-wash { background: linear-gradient(135deg, #e8f4ff, #dffaf6); }
.svc-img.ph-beauty { background: linear-gradient(135deg, #fff3e0, #fdf0d5); }
.svc-body { flex: 1; padding: 20rpx 22rpx; min-width: 0; }
.svc-name { font-size: 30rpx; font-weight: 700; }
.svc-price { font-size: 32rpx; font-weight: 700; color: #e8543a; }
.svc-desc {
  font-size: 23rpx;
  color: #7b8a9a;
  margin-top: 10rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.svc-go { font-size: 23rpx; color: #0b7bd8; font-weight: 600; }
