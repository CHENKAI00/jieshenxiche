<view class="page home">
  <van-notice-bar left-icon="volume-o" color="#0b7bd8" background="#edf5ff"
    text="到店前先预约，免排队：选项目 → 选时段 → 直接开工" />

  <view wx:if="{{loading}}" class="loading">正在读取会员卡…</view>

  <block wx:elif="{{bound}}">
    <!-- 会员卡 -->
    <view class="hero">
      <view class="hero-glow"></view>
      <view class="hero-top">
        <text class="hero-kicker">洁神洗车 · MEMBER</text>
        <text class="hero-plate">{{member.platePretty}}</text>
      </view>

      <view class="hero-balance">
        <text class="cur">¥</text><text class="amount">{{balanceText}}</text>
        <text class="balance-label">卡内余额</text>
      </view>

      <view class="hero-meta">
        <text>{{member.nickname}}</text>
        <text class="dot">·</text>
        <text>{{member.expireAt ? member.expireAt + ' 到期' : '长期有效'}}</text>
      </view>

      <view class="hero-stats">
        <view class="hs"><text class="hs-n">{{member.washCount}}</text><text class="hs-l">洗车</text></view>
        <view class="hs-sep"></view>
        <view class="hs"><text class="hs-n">{{member.waxCount}}</text><text class="hs-l">打蜡</text></view>
        <view class="hs-sep"></view>
        <view class="hs"><text class="hs-n">{{member.remainCount}}</text><text class="hs-l">可用次数</text></view>
      </view>

      <view class="hero-actions">
        <button class="hero-btn" bindtap="goBooking">预约到店</button>
        <view class="hero-link" bindtap="goOrders">我的预约 ›</view>
      </view>
    </view>

    <!-- 进行中预约 -->
    <view class="booking-strip" wx:if="{{activeBooking}}" bindtap="goOrders">
      <view class="bs-left">
        <view class="bs-dot"></view>
        <view class="col">
          <text class="bs-title">{{activeBooking.serviceName}} · {{activeBooking.dateText}} {{activeBooking.time}}</text>
          <text class="bs-sub">预约状态：{{activeBooking.statusText}}</text>
        </view>
      </view>
      <van-icon name="arrow" color="#9db2c6" size="28rpx" />
    </view>

    <!-- 四宫格 -->
    <view class="actions">
      <view class="action" bindtap="goServices">
        <view class="a-ico a-mint"><van-icon name="shop-o" size="40rpx" color="#0d9a8c" /></view>
        <text class="a-t">项目</text>
      </view>
      <view class="action" bindtap="goOrders">
        <view class="a-ico a-gold"><van-icon name="orders-o" size="40rpx" color="#a97a11" /></view>
        <text class="a-t">订单</text>
      </view>
      <view class="action" bindtap="callStore">
        <view class="a-ico a-grey"><van-icon name="phone-o" size="40rpx" color="#5b6b7b" /></view>
        <text class="a-t">门店</text>
      </view>
    </view>

    <!-- 最近一次 -->
    <view class="card last-card">
      <view class="between">
        <text class="last-title">最近一次服务</text>
        <text class="small">{{lastAgo}}</text>
      </view>
      <view class="last-body" wx:if="{{member.lastItem}}">
        <text class="last-item">{{member.lastItem}}</text>
        <text class="last-plate">{{member.platePretty}}</text>
      </view>
      <view class="empty-lite" wx:else>还没有到店记录，约一次试试</view>
    </view>
  </block>

  <block wx:else>
    <view class="card bind-card">
      <view class="bind-ico">🚗</view>
      <view class="bind-title">绑定我的爱车</view>
      <view class="bind-desc">填车牌 + 门店登记的手机号（或后 4 位），就能看到余额、剩余次数和到店记录。</view>
      <button class="btn" bindtap="goBind">立即绑定</button>
    </view>

    <view class="card">
      <view class="h2" style="font-size:30rpx">绑定后可以</view>
      <view class="benefit"><van-icon name="passed" color="#0b7bd8" size="32rpx" /><text>看卡内余额与剩余次数</text></view>
      <view class="benefit"><van-icon name="passed" color="#0b7bd8" size="32rpx" /><text>看累计洗车 / 打蜡次数</text></view>
      <view class="benefit"><van-icon name="passed" color="#0b7bd8" size="32rpx" /><text>预约到店，免排队</text></view>
    </view>
  </block>

  <!-- 店内服务与优惠：不绑卡也能看 -->
  <view class="svc-sec">
    <view class="between" style="margin-bottom:20rpx">
      <text class="sec-title">店内服务与优惠</text>
      <text class="small" bindtap="goServices">全部 ›</text>
    </view>

    <view class="promo" bindtap="callStore">
      <view class="col">
        <text class="promo-title">开业优惠</text>
        <text class="promo-desc">充 500 送 150 · 首次洗车立减 10 元</text>
      </view>
      <text class="promo-btn">咨询</text>
    </view>

    <view wx:if="{{services.length}}" class="svc-list">
      <view wx:for="{{services}}" wx:key="id" class="svc-item" data-id="{{item.id}}" bindtap="bookService">
        <view class="svc-img ph-{{item.phClass}}">
          <image wx:if="{{item.imageUrl}}" class="svc-img__pic" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else class="svc-img__emoji">{{item.emoji}}</text>
        </view>
        <view class="svc-info">
          <view class="svc-head">
            <text class="svc-name">{{item.name}}</text>
            <text class="svc-tag {{item.tag === '美容' ? 'is-beauty' : ''}}">{{item.tag}}</text>
          </view>
          <text class="svc-desc">{{item.desc}}</text>
          <view class="svc-meta">
            <text class="svc-price">¥{{item.price}}</text>
            <text class="svc-mins">约 {{item.mins}} 分钟</text>
          </view>
        </view>
        <text class="svc-arrow">›</text>
      </view>
    </view>

    <view wx:elif="{{servicesError}}" class="svc-empty">
      服务列表暂时读不到：{{servicesError}}
    </view>
    <view wx:else class="svc-empty">正在加载店内服务…</view>
  </view>

  <view class="gap"></view>
  <customer-tabbar active="home" />
</view>
