.home { padding-top: 16rpx; }

/* ============ 会员卡 ============ */
.hero {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 38rpx 34rpx 30rpx;
  background: radial-gradient(120% 120% at 100% 0%, #155b8f 0%, #0d3552 45%, #0a2133 100%);
  color: #fff;
  box-shadow: 0 24rpx 56rpx rgba(8, 30, 48, 0.28);
  margin-bottom: 22rpx;
}
.hero-glow {
  position: absolute;
  right: -120rpx; top: -160rpx;
  width: 420rpx; height: 420rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(23, 195, 178, 0.34) 0%, rgba(23, 195, 178, 0) 70%);
  pointer-events: none;
}
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-kicker { font-size: 20rpx; letter-spacing: 3rpx; color: rgba(255, 255, 255, 0.55); }
.hero-plate {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
}

.hero-balance { display: flex; align-items: baseline; margin-top: 40rpx; }
.cur { font-size: 34rpx; font-weight: 600; color: rgba(255, 255, 255, 0.72); margin-right: 6rpx; }
.amount { font-size: 88rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }
.balance-label {
  margin-left: 18rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
}

.hero-meta {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.62);
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.dot { color: rgba(255, 255, 255, 0.3); }

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}
.hs { flex: 1; display: flex; flex-direction: column; }
.hs-n { font-size: 32rpx; font-weight: 700; }
.hs-l { font-size: 20rpx; color: rgba(255, 255, 255, 0.5); margin-top: 6rpx; letter-spacing: 1rpx; }
.hs-sep { width: 1rpx; height: 44rpx; background: rgba(255, 255, 255, 0.1); }

/* ============ 进行中预约 ============ */
.booking-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 28, 42, 0.05);
}
.bs-left { display: flex; align-items: center; gap: 16rpx; }
.bs-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #17c3b2;
  box-shadow: 0 0 0 8rpx rgba(23, 195, 178, 0.12);
}
.bs-title { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.bs-sub { font-size: 21rpx; color: var(--sub); margin-top: 6rpx; }

/* ============ 四宫格 ============ */
.actions {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 10rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 28, 42, 0.05);
}
.action { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.a-ico {
  width: 84rpx; height: 84rpx;
  border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.a-blue { background: #eef5fd; }
.a-mint { background: #e7f8f5; }
.a-gold { background: #fbf3e2; }
.a-grey { background: #f2f4f7; }
.a-t { font-size: 22rpx; color: #35485a; }

/* ============ 最近一次 ============ */
.last-card { margin-bottom: 0; }
.last-title { font-size: 26rpx; color: var(--sub); letter-spacing: 1rpx; }
.last-body { display: flex; align-items: baseline; gap: 16rpx; margin-top: 18rpx; }
.last-item { font-size: 40rpx; font-weight: 700; color: var(--ink); }
.last-plate { font-size: 24rpx; color: var(--sub); font-family: "SF Mono", Menlo, monospace; }
.empty-lite { color: #b6c0cb; font-size: 24rpx; padding: 20rpx 0 4rpx; }

/* ============ 未绑定 ============ */
.bind-card { text-align: center; padding: 56rpx 40rpx; }
.bind-ico { font-size: 80rpx; }
.bind-title { font-size: 38rpx; font-weight: 700; margin-top: 18rpx; color: var(--ink); }
.bind-desc { font-size: 24rpx; color: var(--sub); line-height: 1.75; margin: 16rpx 0 34rpx; }
.bind-btn { width: 100%; }

.benefit {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #35485a;
}

.loading { text-align: center; color: var(--sub); font-size: 26rpx; padding: 140rpx 0; }
.gap { height: 140rpx; }
