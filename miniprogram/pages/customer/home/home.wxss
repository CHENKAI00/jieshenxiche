.cpage { padding-bottom: 30rpx; }
.tabbar-gap { height: 130rpx; }

.card-hero {
  border-radius: 30rpx;
  padding: 34rpx 30rpx 26rpx;
  background: linear-gradient(145deg, #0b2b4a, #0b5f96 62%, #0b7bd8);
  color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(11, 43, 74, 0.26);
  margin-bottom: 24rpx;
}
.hero-plate { font-family: "SF Mono", Menlo, monospace; font-size: 52rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-nick { font-size: 22rpx; color: rgba(255, 255, 255, 0.72); margin-top: 10rpx; }
.hero-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #d9ecff;
}
.hero-nums { display: flex; margin-top: 36rpx; }
.hn { flex: 1; }
.hn-v { font-size: 46rpx; font-weight: 700; }
.hn-l { display: block; font-size: 20rpx; color: rgba(255, 255, 255, 0.65); margin-top: 6rpx; }
.unit { font-size: 24rpx; margin-left: 6rpx; }
.hero-counts {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}
.hc { display: flex; flex-direction: column; align-items: center; }
.hc.wide { flex: 1; align-items: flex-end; }
.hc-v { font-size: 30rpx; font-weight: 700; }
.hc-l { font-size: 20rpx; color: rgba(255, 255, 255, 0.7); margin-top: 4rpx; }

.quick { display: flex; gap: 18rpx; margin-bottom: 24rpx; }
.q {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(11, 43, 74, 0.05);
}
.q-ico { font-size: 38rpx; }
.q-t { font-size: 28rpx; font-weight: 600; margin-top: 10rpx; }
.q-d { font-size: 21rpx; color: #7b8a9a; margin-top: 4rpx; }

.row-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f5f8;
}
.row-line:last-child { border-bottom: none; }
.k { color: #7b8a9a; font-size: 26rpx; }
.v { font-size: 26rpx; }

.empty-hero {
  background: #fff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(11, 43, 74, 0.06);
  margin-bottom: 24rpx;
}
.eh-ico { font-size: 84rpx; }
.eh-t { font-size: 36rpx; font-weight: 700; margin-top: 16rpx; }
.eh-d { font-size: 24rpx; color: #7b8a9a; line-height: 1.7; margin-top: 12rpx; }

.tip-card { background: #f9fbfe; }
.loading { text-align: center; color: #7b8a9a; font-size: 26rpx; padding: 120rpx 0; }

.booking-card {
  background: linear-gradient(135deg, #eef7ff, #e8fbf7);
  border: 2rpx solid #d6ecff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}
.bk-title { font-size: 27rpx; font-weight: 600; color: #0b2b4a; }
.bk-go { font-size: 24rpx; color: #0b7bd8; font-weight: 600; }
