.mine-head {
  display: flex;
  align-items: center;
  padding: 30rpx 8rpx 34rpx;
}
.avatar {
  width: 104rpx; height: 104rpx; border-radius: 34rpx;
  background: linear-gradient(135deg, #0b7bd8, #17c3b2);
  color: #fff; font-size: 42rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.name { font-size: 36rpx; font-weight: 700; color: var(--ink); }
.sub-line { font-size: 22rpx; color: var(--sub); margin-top: 8rpx; font-family: "SF Mono", Menlo, monospace; }

/* Vant 单元格与页面基调对齐 */
.van-cell-group--inset { margin: 0 0 24rpx; }
.van-cell { padding: 28rpx 30rpx; font-size: 28rpx; }

.ver { text-align: center; color: #b6c0cb; font-size: 20rpx; padding: 20rpx 0 8rpx; }
.gap { height: 140rpx; }
