<view class="page">
  <view class="mine-head">
    <view class="avatar">{{initial}}</view>
    <view class="col grow" style="margin-left:24rpx">
      <text class="name">{{bound ? member.nickname : '车主'}}</text>
      <text class="sub-line">{{bound ? member.platePretty + ' · ' + member.memberNo : '还没有绑定爱车'}}</text>
    </view>
    <text class="tag {{bound ? 'mint' : 'grey'}}">{{bound ? '已绑定' : '未绑定'}}</text>
  </view>

  <van-cell-group inset>
    <van-cell wx:if="{{bound}}" title="我的会员卡" icon="card" is-link bind:click="goHome" />
    <van-cell wx:if="{{bound}}" title="我的预约" icon="orders-o" is-link bind:click="goOrders" />
    <van-cell wx:if="{{!bound}}" title="绑定爱车" icon="add-o" is-link bind:click="goBind" />
    <van-cell title="联系门店" icon="phone-o" is-link bind:click="callStore" />
  </van-cell-group>

  <van-cell-group inset title="更多">
    <van-cell wx:if="{{bound}}" title="解绑这辆车" is-link bind:click="unbind" />
    <van-cell title="切换身份（员工端）" is-link bind:click="switchRole" />
    <van-cell title="关于洁神洗车" is-link bind:click="about" />
  </van-cell-group>

  <view class="ver">洁神洗车 · 车主端 v1.0</view>
  <view class="gap"></view>
  <customer-tabbar active="mine" />
</view>
