<view class="wrap">
  <view class="brand">
    <view class="logo">🧽</view>
    <view class="name">洁神洗车</view>
    <view class="slogan">车主查卡 · 门店核销</view>
  </view>

  <button class="main-btn" bindtap="customerLogin">👤 微信登录，查看我的卡</button>
  <view class="or">余额 · 剩余次数 · 洗车打蜡记录</view>

  <button class="ghost-btn" bindtap="staffLogin">🧑‍🔧 老板 / 门店员工登录</button>
  <view class="or small-or">使用门店员工口令，登录后可拍车牌核销</view>

  <view class="tip">车主登录免费、不需要短信；一个微信绑定一辆车</view>

  <view class="server-entry" bindtap="openServer">
    服务器：{{serverHost}}
  </view>
</view>
