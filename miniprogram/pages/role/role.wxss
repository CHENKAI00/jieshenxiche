page {
  background: linear-gradient(170deg, #0b2b4a 0%, #0b4c7a 55%, #0b7bd8 100%);
  min-height: 100vh;
}
.wrap { padding: 130rpx 48rpx 60rpx; box-sizing: border-box; }
.brand { text-align: center; color: #fff; margin-bottom: 80rpx; }
.logo {
  width: 132rpx; height: 132rpx; line-height: 132rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 64rpx;
}
.name { font-size: 52rpx; font-weight: 700; letter-spacing: 4rpx; }
.slogan { font-size: 24rpx; color: rgba(255, 255, 255, 0.7); margin-top: 14rpx; }

.main-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #0b2b4a;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(3, 22, 40, 0.24);
}
.main-btn::after { border: none; }
.ghost-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 28rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.3);
  margin-top: 34rpx;
}
.ghost-btn::after { border: none; }
.or {
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  margin-top: 18rpx;
}
.small-or { margin-top: 14rpx; }
.tip {
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 21rpx;
  margin-top: 90rpx;
  line-height: 1.7;
}
