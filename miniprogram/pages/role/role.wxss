page {
  background: linear-gradient(170deg, #0b2b4a 0%, #0b4c7a 55%, #0b7bd8 100%);
  min-height: 100vh;
}
.wrap { padding: 120rpx 48rpx 60rpx; box-sizing: border-box; }
.brand { text-align: center; color: #fff; margin-bottom: 70rpx; }
.logo {
  width: 132rpx; height: 132rpx; line-height: 132rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 64rpx;
}
.name { font-size: 52rpx; font-weight: 700; letter-spacing: 4rpx; }
.slogan { font-size: 24rpx; color: rgba(255, 255, 255, 0.7); margin-top: 14rpx; }

.cards { display: flex; flex-direction: column; gap: 24rpx; }
.choose {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border-radius: 26rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(3, 22, 40, 0.24);
}
.ico {
  width: 88rpx; height: 88rpx; line-height: 88rpx;
  text-align: center; font-size: 42rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #e8f4ff, #dffaf6);
  flex: none;
}
.t { font-size: 34rpx; font-weight: 700; color: #0b2b4a; }
.d { font-size: 23rpx; color: #7b8a9a; margin-top: 8rpx; line-height: 1.5; }
.arrow { font-size: 44rpx; color: #c3ccd6; }
.tip { text-align: center; color: rgba(255, 255, 255, 0.6); font-size: 22rpx; margin-top: 46rpx; }
