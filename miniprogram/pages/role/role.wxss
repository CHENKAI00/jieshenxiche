page {
  background: linear-gradient(170deg, #0b2b4a 0%, #0b4c7a 55%, #0b7bd8 100%);
  min-height: 100vh;
}
.wrap { padding: 130rpx 48rpx 60rpx; box-sizing: border-box; }
.brand { text-align: center; color: #fff; margin-bottom: 80rpx; }
.logo {
  width: 132rpx; height: 132rpx; line-height: 132rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 64rpx;
}
.name { font-size: 52rpx; font-weight: 700; letter-spacing: 4rpx; }
.slogan { font-size: 24rpx; color: rgba(255, 255, 255, 0.7); margin-top: 14rpx; }

.main-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  line-height: 1;
  border-radius: 18rpx;
  background: #fff;
  color: #0b2b4a;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(3, 22, 40, 0.24);
}
.main-btn::after { border: none; }
.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  line-height: 1;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 28rpx;
  border: 1.5rpx solid rgba(255, 255, 255, 0.3);
  margin-top: 34rpx;
}
.ghost-btn::after { border: none; }
.or {
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  margin-top: 18rpx;
}
.small-or { margin-top: 14rpx; }
.tip {
  text-align: center;
  color: rgba(255, 255, 255, 0.5);
  font-size: 21rpx;
  margin-top: 90rpx;
  line-height: 1.7;
}

.server-entry {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 按钮下方的诊断入口：白底半透明胶囊，保证在任何机型上都看得见 */
.diag {
  margin: 28rpx auto 0;
  padding: 16rpx 28rpx;
  width: fit-content;
  max-width: 100%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.diag-t { font-size: 24rpx; color: #fff; font-weight: 600; }
.diag-s {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
