<view class="page">
  <view class="search">
    <input class="search-input" value="{{keyword}}" placeholder="车牌 / 姓名 / 手机 / 卡号"
           bindinput="onKeyword" confirm-type="search" bindconfirm="doSearch" />
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">没有匹配的会员</view>

  <view wx:for="{{list}}" wx:key="id" class="card mrow" data-plate="{{item.plateNo}}" bindtap="openMember">
    <view class="between">
      <view class="col">
        <view class="row" style="gap:12rpx">
          <text class="plate" style="font-size:34rpx">{{item.platePretty}}</text>
          <text wx:if="{{item.remainCount > 0}}" class="tag mint">次卡 {{item.remainCount}}</text>
          <text wx:else class="tag grey">余额</text>
        </view>
        <view class="small" style="margin-top:8rpx">{{item.nickname}} · {{item.phone || '无手机'}} · {{item.memberNo}}</view>
        <view class="small" style="margin-top:4rpx">洗车 {{item.washCount}} 次 · 打蜡 {{item.waxCount}} 次{{item.lastItem ? ' · 上次 ' + item.lastItem : ''}}</view>
      </view>
      <view class="col" style="align-items:flex-end">
        <text style="font-size:30rpx;font-weight:700">¥{{item.balanceText}}</text>
        <text class="small">{{item.agoText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="more" bindtap="loadMore">加载更多</view>
  <view class="foot">共 {{total}} 位会员</view>
</view>
