.search { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search-input {
  flex: 1;
  height: 84rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.search-btn {
  width: 140rpx; height: 84rpx; line-height: 84rpx;
  text-align: center;
  background: linear-gradient(135deg, #0b7bd8, #17c3b2);
  color: #fff; border-radius: 20rpx; font-weight: 600;
}
.mrow { padding: 24rpx; }
.flow { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f4f7fa; }
.flow:last-child { border-bottom: none; }
.flow-title { font-size: 28rpx; font-weight: 600; }
.flow-amt { font-size: 28rpx; font-weight: 700; color: #e8543a; }
.flow-amt.in { color: #0f9b8e; }
.more { text-align: center; color: #0b7bd8; font-size: 26rpx; padding: 20rpx 0; }
.foot { text-align: center; color: #b3bfcc; font-size: 20rpx; padding-top: 12rpx; }
