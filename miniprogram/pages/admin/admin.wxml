<view class="page">
  <view class="card board">
    <view class="between">
      <view class="h2" style="color:#fff">门店看板</view>
      <text class="small" style="color:rgba(255,255,255,0.7)">{{stat.date}}</text>
    </view>
    <view class="board-grid">
      <view class="b-item">
        <view class="b-num">{{stat.todayVisits || 0}}</view>
        <view class="b-label">今日到店</view>
      </view>
      <view class="b-item">
        <view class="b-num">{{stat.todayNew || 0}}</view>
        <view class="b-label">今日新客</view>
      </view>
      <view class="b-item">
        <view class="b-num">{{stat.members || 0}}</view>
        <view class="b-label">会员数</view>
      </view>
    </view>
    <view class="board-sub">
      储值 ¥{{stat.balanceSum || '0.00'}} · 未消耗 {{stat.remainSum || 0}} 次 · 累计洗车 {{stat.washSum || 0}} / 打蜡 {{stat.waxSum || 0}}
    </view>
  </view>

  <view class="card">
    <view class="h2">快速核销</view>
    <view class="small" style="margin:12rpx 0 20rpx">输车牌 → 选服务项目，洗车 / 打蜡都能核销</view>
    <view class="row" style="gap:16rpx">
      <input class="input grow" value="{{plate}}" maxlength="8" placeholder="粤B12345"
             bindinput="onPlate" confirm-type="search" bindconfirm="quickLookup" />
      <view class="qbtn" bindtap="quickLookup">查会员</view>
    </view>
    <view wx:if="{{quickMember && quickMember.exists}}" class="quick-res">
      <view class="between">
        <view class="col">
          <text style="font-weight:700">{{quickMember.platePretty}} · {{quickMember.nickname}}</text>
          <text class="small">余额 ¥{{quickBalance}} · 剩余 {{quickMember.remainCount}} 次 · 洗车 {{quickMember.washCount}} / 打蜡 {{quickMember.waxCount}}</text>
        </view>
        <view class="tag mint">可用</view>
      </view>
      <button class="btn" style="margin-top:20rpx;height:76rpx;line-height:76rpx;font-size:28rpx" bindtap="openConsume">选择服务核销</button>
    </view>
    <view wx:elif="{{quickMember && quickMember.exists === false}}" class="quick-res">
      <text class="small">该车牌未建档</text>
      <button class="btn ghost" style="margin-top:16rpx;height:76rpx;line-height:76rpx;font-size:28rpx" bindtap="goCreate">去建档</button>
    </view>
  </view>

  <view class="card">
    <view class="between">
      <view class="h2">今日预约（{{bookings.length}}）</view>
      <text class="small" bindtap="loadBookings">刷新</text>
    </view>
    <view wx:if="{{bookings.length === 0}}" class="empty">今天还没有预约</view>
    <view wx:for="{{bookings}}" wx:key="id" class="bk-item">
      <view class="between">
        <view class="col">
          <view class="row" style="gap:10rpx">
            <text class="bk-time">{{item.time}}</text>
            <text class="bk-svc">{{item.serviceName}}</text>
            <van-tag type="{{item.tagType}}" plain="{{item.plain}}">{{item.statusText}}</van-tag>
          </view>
          <text class="small" style="margin-top:6rpx">{{item.platePretty}}{{item.remark ? ' · ' + item.remark : ''}}</text>
        </view>
        <view class="bk-actions">
          <button wx:if="{{item.status === 'pending'}}" class="btn-mini primary"
                      data-id="{{item.id}}" data-s="confirmed" bindtap="advance">确认</button>
          <button wx:if="{{item.status === 'confirmed'}}" class="btn-mini primary"
                      data-id="{{item.id}}" data-s="serving" bindtap="advance">开工</button>
          <button wx:if="{{item.status === 'serving'}}" class="btn-mini primary"
                      data-id="{{item.id}}" bindtap="finish">完成核销</button>
          <button wx:if="{{item.canCancel}}" class="btn-mini"
                      data-id="{{item.id}}" data-s="cancelled" bindtap="advance">取消</button>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="between">
      <view class="h2">最近到店</view>
      <text class="small" bindtap="refresh">刷新</text>
    </view>
    <view wx:if="{{recent.length === 0}}" class="empty">暂无到店记录</view>
    <view wx:for="{{recent}}" wx:key="id" class="flow" data-plate="{{item.plateNo}}" bindtap="openMember">
      <view class="col grow">
        <view class="row" style="gap:10rpx">
          <text class="flow-plate">{{item.platePretty}}</text>
          <text class="tag {{item.tagClass}}">{{item.lastItem || '到店'}}</text>
        </view>
        <view class="small" style="margin-top:6rpx">{{item.nickname}} · {{item.agoText}}</view>
      </view>
      <view class="col" style="align-items:flex-end">
        <view class="small">洗车 {{item.washCount}} · 打蜡 {{item.waxCount}}</view>
        <view style="font-size:28rpx;font-weight:700;color:#0b7bd8">余 {{item.remainCount}} 次</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="between">
      <view class="col">
        <view class="h2">服务状态</view>
        <view class="small" style="margin-top:8rpx">数据库 {{health.db}} · 识别引擎 {{health.ocr}}</view>
      </view>
      <view class="tag {{health.db === 'up' ? 'mint' : 'grey'}}">{{health.db === 'up' ? '正常' : '异常'}}</view>
    </view>
  </view>

  <view class="foot">洁神洗车 · 门店工作台 v2</view>
</view>
