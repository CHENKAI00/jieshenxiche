page {
  background: var(--color-bg, #f5f7fa);
}

.demo-page {
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.demo-head {
  padding: 8rpx 4rpx 28rpx;
}
.demo-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text, #1f2937);
  letter-spacing: 0.5rpx;
}
.demo-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b7280);
}

.demo-card {
  background: var(--color-card, #ffffff);
  border-radius: var(--radius-md, 16rpx);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.05);
}
.demo-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text, #1f2937);
  margin-bottom: 24rpx;
}

.demo-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.demo-row:last-child {
  margin-bottom: 0;
}
.demo-row--baseline {
  align-items: flex-end;
}
.demo-gap {
  height: 24rpx;
}

.demo-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b7280);
}

/* 车牌后缀相机按钮 */
.demo-camera {
  width: 88rpx;
  height: 88rpx;
  margin-right: -24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 var(--radius-md, 16rpx) var(--radius-md, 16rpx) 0;
  background: var(--color-primary-light, #eaf2ff);
}
.demo-camera.is-loading {
  background: var(--color-primary-light, #eaf2ff);
}
.demo-camera__icon {
  font-size: 36rpx;
  line-height: 1;
}
.demo-camera__spinner {
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 3rpx solid rgba(43, 127, 255, 0.25);
  border-top-color: var(--color-primary, #2b7fff);
  animation: demo-spin 0.8s linear infinite;
}
@keyframes demo-spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------------- 客户视角：优惠与服务 ---------------- */
.promo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: var(--radius-md, 16rpx);
  background: var(--color-primary-light, #eaf2ff);
  margin-bottom: 24rpx;
}
.promo__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary, #2b7fff);
}
.promo__desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b7280);
}
.promo__btn {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-full, 999rpx);
  background: var(--color-card, #ffffff);
  color: var(--color-primary, #2b7fff);
  font-size: 24rpx;
  font-weight: 600;
}

.svc {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #eef1f5;
}
.svc:first-of-type {
  border-top: none;
  padding-top: 0;
}
.svc__main {
  flex: 1;
  min-width: 0;
}
.svc__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.svc__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text, #1f2937);
}
.svc__tag {
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full, 999rpx);
  font-size: 20rpx;
  background: var(--color-primary-light, #eaf2ff);
  color: var(--color-primary, #2b7fff);
}
.svc__tag.is-beauty {
  background: #fdf3e5;
  color: #b26a12;
}
.svc__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b7280);
  line-height: 1.5;
}
.svc__meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 10rpx;
}
.svc__price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text, #1f2937);
}
.svc__mins {
  font-size: 22rpx;
  color: var(--color-placeholder, #9ca3af);
}
.svc__promo {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #fdecec;
  color: var(--color-danger, #ef4444);
  font-size: 20rpx;
}
.svc__btn {
  flex: none;
}

.demo-foot {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-placeholder, #9ca3af);
  padding: 16rpx 0 8rpx;
}
