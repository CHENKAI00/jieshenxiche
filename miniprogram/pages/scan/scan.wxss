.tip-bar {
  background: #eaf4ff;
  color: #20659b;
  font-size: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.shoot {
  position: relative;
  height: 420rpx;
  border-radius: 28rpx;
  background: linear-gradient(150deg, #0b2b4a, #0d5a8f);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.shoot.has-img { background: #000; }
.shoot-inner { text-align: center; color: #fff; }
.shoot-ico { font-size: 80rpx; }
.shoot-title { font-size: 34rpx; font-weight: 700; margin: 12rpx 0 8rpx; }
.shoot-inner .small { color: rgba(255,255,255,0.6); }
.frame {
  position: absolute;
  left: 60rpx; right: 60rpx; top: 96rpx; bottom: 96rpx;
  border: 4rpx dashed rgba(255,255,255,0.35);
  border-radius: 16rpx;
}
.shot { width: 100%; height: 100%; }
.shot-mask {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  color: #fff; font-size: 24rpx; text-align: center;
  padding: 16rpx 0;
}

.pick-row { display: flex; gap: 18rpx; margin: 24rpx 0; }
.pick {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #35485a;
  box-shadow: 0 6rpx 20rpx rgba(11,43,74,0.05);
}

.result-card { padding: 30rpx 28rpx; }
.member-row { display: flex; align-items: center; }
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 44rpx;
  background: linear-gradient(135deg, #0b7bd8, #17c3b2);
  color: #fff; font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.mini-grid { display: flex; margin-top: 24rpx; }
.mini {
  flex: 1;
  background: #f6f9fc;
  border-radius: 16rpx;
  padding: 18rpx 0;
  text-align: center;
  margin-right: 12rpx;
}
.mini:last-child { margin-right: 0; }
.mini-num { font-size: 30rpx; font-weight: 700; color: #0b2b4a; }
.unit { font-size: 22rpx; color: #7b8a9a; margin-left: 4rpx; }
.mini-label { font-size: 22rpx; color: #7b8a9a; margin-top: 6rpx; }

.warn-box {
  margin-top: 20rpx;
  background: #fff7ec;
  color: #b26a12;
  font-size: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  line-height: 1.5;
}

.mask {
  position: fixed; inset: 0;
  background: rgba(9, 22, 35, 0.55);
  display: flex; align-items: flex-end;
  z-index: 99;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}
.foot { text-align: center; color: #b3bfcc; font-size: 20rpx; padding-top: 8rpx; }

.correct-tip { margin-top: 12rpx; font-size: 22rpx; color: #0d8d80; background: #e7f8f5; padding: 10rpx 16rpx; border-radius: 10rpx; display: inline-block; }
.suggest-tip { margin-top: 12rpx; font-size: 22rpx; color: #9a7220; background: #fbf3e2; padding: 10rpx 16rpx; border-radius: 10rpx; display: inline-block; }

/* 拍照识别：主入口，实心主色 */
.pick.strong {
  background: var(--color-primary, #2b7fff);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(43, 127, 255, 0.18);
}
