.hero {
  background: linear-gradient(160deg, #0b2b4a 0%, #0b4c7a 55%, #0b7bd8 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(11, 43, 74, 0.22);
}
.hero-sub { color: rgba(255, 255, 255, 0.75); font-size: 24rpx; margin-top: 8rpx; }
.dot-badge {
  background: rgba(255, 255, 255, 0.16);
  color: #d9ecff;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
}
.scan-btn {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.scan-ico {
  width: 84rpx; height: 84rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #e8f4ff, #dffaf6);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.arrow { font-size: 44rpx; color: #b9c7d6; padding-right: 6rpx; }

.manual {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.manual-input {
  flex: 1;
  height: 84rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  padding: 0 24rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}
.ph { color: #9aa9b8; letter-spacing: 0; }
.manual-btn {
  width: 150rpx; height: 84rpx; line-height: 84rpx;
  text-align: center; border-radius: 20rpx;
  background: #17c3b2; color: #fff; font-weight: 600;
}
.manual-btn.off { background: rgba(255, 255, 255, 0.25); color: rgba(255,255,255,0.7); }

.stat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(11, 43, 74, 0.06);
}
.stat { }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #0b2b4a; }
.stat-label { font-size: 22rpx; color: #7b8a9a; margin-top: 6rpx; }
.stat-split { width: 1rpx; height: 52rpx; background: #eef1f5; }

.grid {
  display: flex;
  gap: 18rpx;
  margin-bottom: 24rpx;
}
.grid-item {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(11, 43, 74, 0.05);
}
.grid-ico { font-size: 40rpx; }
.grid-txt { font-size: 22rpx; color: #35485a; margin-top: 8rpx; }

.rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f5f8;
}
.rec:last-child { border-bottom: none; }
.rec-plate { font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; }
.rec-amt { font-size: 28rpx; font-weight: 600; color: #0b7bd8; }

.foot { text-align: center; color: #b3bfcc; font-size: 20rpx; padding: 20rpx 0 0; }
