<view class="page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-top between">
      <view>
        <view class="h1" style="color:#fff">洁神洗车</view>
        <view class="hero-sub">拍照识车牌 · 一秒查会员</view>
      </view>
      <view class="dot-badge">{{staffName}}</view>
    </view>

    <view class="scan-btn" bindtap="goScan">
      <view class="scan-ico">📷</view>
      <view class="col grow">
        <view style="font-size:34rpx;font-weight:700;color:#0b2b4a">拍车牌查会员</view>
        <view class="small" style="margin-top:6rpx">对准车牌 → 自动识别 → 出会员卡</view>
      </view>
      <view class="arrow">›</view>
    </view>

    <view class="manual">
      <input
        class="manual-input"
        value="{{plate}}"
        placeholder="也可以手输车牌，如 粤B12345"
        placeholder-class="ph"
        maxlength="8"
        bindinput="onPlateInput"
        confirm-type="search"
        bindconfirm="lookupManual"
      />
      <view class="manual-btn {{plate ? '' : 'off'}}" bindtap="lookupManual">查询</view>
    </view>
  </view>

  <!-- 今日概览 -->
  <view class="stat-card">
    <view class="stat between">
      <view class="stat-item">
        <view class="stat-num">{{stat.todayVisits || 0}}</view>
        <view class="stat-label">今日到店</view>
      </view>
      <view class="stat-split"></view>
      <view class="stat-item">
        <view class="stat-num">{{stat.todayNew || 0}}</view>
        <view class="stat-label">今日新客</view>
      </view>
      <view class="stat-split"></view>
      <view class="stat-item">
        <view class="stat-num">{{stat.members || 0}}</view>
        <view class="stat-label">会员总数</view>
      </view>
    </view>
    <view class="divider"></view>
    <view class="between">
      <text class="small">储值 ¥{{stat.balanceSum || '0.00'}} · 待用 {{stat.remainSum || 0}} 次 · 累计洗车 {{stat.washSum || 0}}</text>
      <text class="small" style="color:#0b7bd8" bindtap="refresh">刷新</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="grid">
    <view class="grid-item" bindtap="goScan">
      <view class="grid-ico">🚗</view>
      <view class="grid-txt">识别车牌</view>
    </view>
    <view class="grid-item" bindtap="goAdmin">
      <view class="grid-ico">🧾</view>
      <view class="grid-txt">服务核销</view>
    </view>
    <view class="grid-item" bindtap="goCatalog">
      <view class="grid-ico">🧽</view>
      <view class="grid-txt">店内项目</view>
    </view>
    <view class="grid-item" bindtap="goMembers">
      <view class="grid-ico">👥</view>
      <view class="grid-txt">会员名录</view>
    </view>
  </view>

  <!-- 最近到店 -->
  <view class="card">
    <view class="between">
      <view class="h2">最近到店</view>
      <text class="small" bindtap="goAdmin">全部 ›</text>
    </view>
    <view wx:if="{{recent.length === 0}}" class="empty">还没有服务记录</view>
    <view wx:for="{{recent}}" wx:key="id" class="rec" data-plate="{{item.plateNo}}" bindtap="openMember">
      <view class="rec-left">
        <view class="row" style="gap:12rpx">
          <text class="rec-plate">{{item.platePretty}}</text>
          <text class="tag {{item.tagClass}}">{{item.lastItem || '到店'}}</text>
        </view>
        <view class="small" style="margin-top:6rpx">{{item.nickname}} · {{item.agoText}}</view>
      </view>
      <view class="col" style="align-items:flex-end">
        <view class="small">洗车 {{item.washCount}} · 打蜡 {{item.waxCount}}</view>
        <view class="rec-amt">余 {{item.remainCount}} 次</view>
      </view>
    </view>
  </view>

  <view class="foot">洁神洗车 · 单表会员系统 v2</view>
</view>
