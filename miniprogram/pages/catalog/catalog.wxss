.banner {
  border-radius: 26rpx;
  padding: 34rpx 30rpx;
  background: linear-gradient(140deg, #0b2b4a, #0b5f96 60%, #0b7bd8);
  color: #fff;
  box-shadow: 0 14rpx 36rpx rgba(11, 43, 74, 0.22);
  margin-bottom: 22rpx;
}
.banner-title { font-size: 40rpx; font-weight: 700; }
.banner-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.78); margin-top: 8rpx; }
.banner-tip {
  display: inline-block;
  margin-top: 18rpx;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
}

.tabs { white-space: nowrap; margin-bottom: 20rpx; }
.tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #5b6b7b;
  font-size: 26rpx;
}
.tab.on { background: linear-gradient(135deg, #0b7bd8, #17c3b2); color: #fff; font-weight: 600; }

.svc-card {
  display: flex;
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 26rpx rgba(11, 43, 74, 0.06);
}
.svc-img { width: 220rpx; height: 176rpx; flex: none; }
.svc-img.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: linear-gradient(135deg, #e8f4ff, #dffaf6);
}
.svc-img.ph-美容 { background: linear-gradient(135deg, #fff3e0, #fdf0d5); }

.svc-body { flex: 1; padding: 20rpx 22rpx; min-width: 0; }
.svc-name { font-size: 30rpx; font-weight: 700; }
.svc-price { font-size: 32rpx; font-weight: 700; color: #e8543a; }
.svc-desc {
  font-size: 23rpx;
  color: #7b8a9a;
  margin-top: 10rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.svc-go { font-size: 24rpx; color: #0b7bd8; font-weight: 600; }

.mask {
  position: fixed; inset: 0;
  background: rgba(9, 22, 35, 0.55);
  display: flex; align-items: flex-end;
  z-index: 99;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 34rpx 30rpx 50rpx;
  box-sizing: border-box;
}
.qbtn {
  width: 150rpx; height: 88rpx; line-height: 88rpx;
  text-align: center; border-radius: 16rpx;
  background: linear-gradient(135deg, #0b7bd8, #17c3b2);
  color: #fff; font-size: 26rpx; font-weight: 600;
}
.found { margin-top: 24rpx; background: #f6f9fc; border-radius: 18rpx; padding: 22rpx; }
.pay-row { display: flex; gap: 18rpx; margin-top: 20rpx; }
.pay {
  flex: 1;
  border: 2rpx solid #e8eef5;
  border-radius: 18rpx;
  padding: 20rpx 18rpx;
  background: #fbfdff;
}
.pay.on { border-color: #0b7bd8; background: #eef7ff; }
.pay-t { font-size: 28rpx; font-weight: 600; margin-bottom: 6rpx; }

.foot { text-align: center; color: #b3bfcc; font-size: 20rpx; padding: 10rpx 0 30rpx; }
