/* ============ WashField ============ */
.wash-field {
  width: 100%;
}

.wash-field__label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary, #6b7280);
}
.wash-field__required {
  color: var(--color-danger, #ef4444);
  font-size: 26rpx;
  line-height: 1;
}

.wash-field__box {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--color-bg, #f5f7fa);
  border: 1rpx solid transparent;
  border-radius: var(--radius-md, 16rpx);
  transition: background-color 120ms ease-out, border-color 120ms ease-out,
    box-shadow 120ms ease-out;
}

/* 聚焦：白底 + 主色边框 + 轻焦点环 */
.wash-field__box.is-focus {
  background: var(--color-card, #ffffff);
  border-color: var(--color-primary, #2b7fff);
  box-shadow: 0 0 0 4rpx rgba(43, 127, 255, 0.12);
}

/* 错误：红边（下方另出文案） */
.wash-field.is-error .wash-field__box {
  background: var(--color-card, #ffffff);
  border-color: var(--color-danger, #ef4444);
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.1);
}

/* 禁用 */
.wash-field.is-disabled .wash-field__box {
  background: #f0f2f5;
  border-color: transparent;
  box-shadow: none;
}

.wash-field__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  color: var(--color-text, #1f2937);
  line-height: 88rpx;
}
.wash-field__input.is-plate {
  font-size: 32rpx;
  letter-spacing: 2rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-weight: 600;
}
.wash-field__input:disabled {
  color: var(--color-placeholder, #9ca3af);
}

.wash-field__ph {
  color: var(--color-placeholder, #9ca3af);
  font-size: 28rpx;
  font-weight: 400;
}

.wash-field__icon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
}
.wash-field__icon-text {
  width: 40rpx;
  flex: none;
  font-size: 32rpx;
  line-height: 1;
  text-align: center;
}

/* 清空按钮：点击区 56×56，图标 28 */
.wash-field__clear {
  width: 56rpx;
  height: 56rpx;
  margin-right: -8rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.wash-field__clear--hover {
  background: rgba(31, 41, 55, 0.06);
}
.wash-field__clear-icon {
  width: 28rpx;
  height: 28rpx;
  line-height: 26rpx;
  text-align: center;
  border-radius: 50%;
  background: #c7ccd4;
  color: #ffffff;
  font-size: 22rpx;
}

/* 后缀（如车牌相机按钮） */
.wash-field__suffix {
  flex: none;
  display: flex;
  align-items: center;
}

.wash-field__error {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-danger, #ef4444);
  line-height: 1.4;
}
.wash-field__hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary, #6b7280);
  line-height: 1.4;
}
.wash-field__count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-placeholder, #9ca3af);
}
.wash-field__count.is-error {
  color: var(--color-danger, #ef4444);
}
