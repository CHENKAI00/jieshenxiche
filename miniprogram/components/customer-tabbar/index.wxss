.bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(11, 43, 74, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 90;
}
.item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0 10rpx;
  color: #8a97a6;
}
.item.on { color: #0b7bd8; }
.ico { font-size: 38rpx; line-height: 1.1; }
.txt { font-size: 20rpx; margin-top: 4rpx; }
