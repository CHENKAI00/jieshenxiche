/* 洁神洗车 · 设计基准
   目标：留白更大、层级更清楚、少用重色彩，靠排版和阴影撑质感 */
page {
  --brand: #0b7bd8;
  --brand-deep: #0b2233;
  --mint: #17c3b2;
  --gold: #c99a3c;
  --ink: #0f1c2a;
  --text: #16232f;
  --sub: #8a97a6;
  --line: #edf1f6;
  --card: #ffffff;
  --bg: #f5f7fa;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

.page {
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 34rpx rgba(15, 28, 42, 0.05);
  margin-bottom: 24rpx;
}

.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }

.h1 { font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.h2 { font-size: 32rpx; font-weight: 700; letter-spacing: 0.5rpx; }
.sub { color: var(--sub); font-size: 24rpx; }
.small { font-size: 22rpx; color: var(--sub); line-height: 1.6; }
.mono { font-family: "SF Mono", Menlo, monospace; letter-spacing: 2rpx; }

.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #fff;
  background: #0b7bd8;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(11, 123, 216, 0.16);
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.btn::after { border: none; }
.btn:active { transform: scale(0.985); opacity: 0.92; }
.btn.ghost {
  background: #fff;
  color: var(--brand);
  border: 1.5rpx solid #cfe2f5;
  box-shadow: none;
}
.btn.ghost:active { background: #f4f9ff; }
.btn.warn { background: #e8543a; box-shadow: 0 6rpx 18rpx rgba(232, 84, 58, 0.18); }
.btn.disabled { opacity: 0.5; }

/* 小按钮（列表里的操作） */
.btn-mini {
  display: inline-block;
  height: 58rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #0b7bd8;
  background: #fff;
  border: 1.5rpx solid #cfe2f5;
  margin-left: 12rpx;
}
.btn-mini::after { border: none; }
.btn-mini.primary { background: #0b7bd8; color: #fff; border-color: #0b7bd8; }
.btn-mini.danger { color: #d9463a; border-color: #f3cdc8; }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: #eef5fd;
  color: var(--brand);
  letter-spacing: 0.5rpx;
}
.tag.gold { background: #fbf3e2; color: #9a7220; }
.tag.mint { background: #e7f8f5; color: #0d8d80; }
.tag.grey { background: #f1f3f6; color: var(--sub); }

.plate {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.divider { height: 1rpx; background: var(--line); margin: 26rpx 0; }
.empty { text-align: center; color: var(--sub); padding: 70rpx 0; font-size: 26rpx; }

.input {
  height: 88rpx;
  background: #f6f8fb;
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}

/* 页面标题区（各页统一） */
.page-head { padding: 8rpx 4rpx 20rpx; }
.page-head .t { font-size: 40rpx; font-weight: 700; letter-spacing: 0.5rpx; }
.page-head .s { font-size: 23rpx; color: var(--sub); margin-top: 8rpx; }

/* ============================================================
   设计令牌（详见 docs/UI规范.md）
   命名：--c-* 颜色 / --radius-* 圆角 / --space-* 间距
         --font-* 字号 / --shadow-* 阴影
   落地时页面只用这些变量，不再写死色值。
   ============================================================ */
page {
  --c-primary:         #146FE0;
  --c-primary-pressed: #0F57B3;
  --c-primary-weak:    #EAF3FF;
  --c-primary-border:  #C7DDF8;

  --c-success:      #12A150;
  --c-success-weak: #E8F7EF;
  --c-warning:      #D97917;
  --c-warning-weak: #FDF3E5;
  --c-error:        #D93F3F;
  --c-error-weak:   #FDECEC;

  --c-text:        #1A2230;
  --c-text-2:      #5A6B7F;
  --c-text-3:      #8C9AAB;
  --c-placeholder: #A9B4C2;

  --c-bg:            #F4F7FA;
  --c-card:          #FFFFFF;
  --c-fill:          #F6F8FB;
  --c-fill-disabled: #F1F4F8;
  --c-border:        #E3E9F0;
  --c-border-strong: #D6E0EC;

  --radius-sm:   8rpx;
  --radius-md:   12rpx;
  --radius-lg:   16rpx;
  --radius-xl:   24rpx;
  --radius-pill: 999rpx;

  --space-1: 4rpx;
  --space-2: 8rpx;
  --space-3: 12rpx;
  --space-4: 16rpx;
  --space-5: 24rpx;
  --space-6: 32rpx;

  --font-24: 24rpx;
  --font-26: 26rpx;
  --font-28: 28rpx;
  --font-30: 30rpx;
  --font-32: 32rpx;

  --shadow-card:  0 8rpx 24rpx rgba(20, 40, 70, 0.06);
  --shadow-float: 0 16rpx 48rpx rgba(20, 40, 70, 0.12);
  --shadow-btn:   0 4rpx 12rpx rgba(20, 111, 224, 0.12);
}

/* ===== WashButton / WashField 设计令牌 ===== */
page {
  --color-primary: #2B7FFF;
  --color-primary-pressed: #1F66D9;
  --color-primary-light: #EAF2FF;
  --color-text: #1F2937;
  --color-text-secondary: #6B7280;
  --color-placeholder: #9CA3AF;
  --color-bg: #F5F7FA;
  --color-card: #FFFFFF;
  --color-danger: #EF4444;
  --radius-md: 16rpx;
  --radius-full: 999rpx;
}
